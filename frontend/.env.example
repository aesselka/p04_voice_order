# Пусто = встроенный mock-движок (без бэка)
# Адрес Python-бэка voice_cart_nlu (uvicorn), запросы идут через прокси Vite:
VITE_API_URL=http://127.0.0.1:8000

# browser = распознавание в Chrome (Web Speech API), ключ не нужен
# server  = аудио уходит на /cart/{id}/voice (нужен ELEVENLABS_API_KEY в .env бэка)
VITE_STT=browser
