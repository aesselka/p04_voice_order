# Copy to .env and fill in. Never commit .env.

# Required for voice input (ElevenLabs Scribe): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional: LLM fallback for phrases the rules parser is unsure about (pip install anthropic)
# ANTHROPIC_API_KEY=

# Optional: local Whisper instead of / as backup to ElevenLabs (pip install faster-whisper)
# STT_PROVIDER=whisper
# WHISPER_FALLBACK=1
# WHISPER_MODEL=small

# Optional: custom menu, same format as voice_cart_nlu/data/menu.json
# MENU_PATH=
